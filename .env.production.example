# ==============================================================================
# SGrowing AI-Native Growth OS — Enterprise Production Environment Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit the populated `.env` file to source control.
# 2. Generate cryptographically strong random secrets for all passwords & keys.
# 3. Compatible with `docker-compose.prod.yml` and self-hosted Kubernetes setups.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM ENVIRONMENT & ORCHESTRATION
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
PUBLIC_DOMAIN=growth.yourcompany.com
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 17 DATABASE ENGINE (pgvector + Multi-Tenant RLS)
# ------------------------------------------------------------------------------
POSTGRES_USER=sgrowing_app
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD_MIN_32_CHARS
POSTGRES_DB=sgrowing_prod
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. REDIS 7.4 STATE STORE, STREAM BROKER & DISTRIBUTED LOCKS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. MINIO S3 OBJECT STORAGE (Sealed Contract Vault & Mirrors)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=sgrowing_s3_admin
# Generate with: openssl rand -base64 32
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_SECRET_KEY_MIN_32_CHARS
MINIO_DEFAULT_BUCKET=sgrowing-vault
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC SECURITY & AUTHENTICATION (PRD Section 4.2)
# ------------------------------------------------------------------------------
# High-entropy JWT Signing Key (Must be at least 64 characters / 512 bits)
# Generate with: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_SUPER_SECRET_64_CHAR_JWT_SIGNING_KEY_HEX_OR_BASE64_ABC123!
JWT_ISSUER=https://growth.yourcompany.com
JWT_AUDIENCE=SGrowing.Clients
JWT_LIFETIME_MINUTES=60

# Master Tenant Encryption Key for Field-Level Data Encryption (AES-256-GCM)
# Generate with: openssl rand -hex 32 (exactly 64 hex characters)
MASTER_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_ENCRYPTION_KEY_FOR_DATA_SEALING

# ------------------------------------------------------------------------------
# 6. OPENTELEMETRY OBSERVABILITY
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_METRICS_EXPORTER=prometheus

# ------------------------------------------------------------------------------
# 7. SERVICE PORTS & REVERSE PROXY BINDINGS
# ------------------------------------------------------------------------------
API_PORT=5000
MCP_PORT=7890
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 8. AI GATEWAY PROVIDERS (Multi-Model Fallback Chain - PRD Domain J)
# ------------------------------------------------------------------------------
AI_OPENAI_API_KEY=sk-proj-REPLACE_WITH_OPENAI_PRODUCTION_KEY
AI_ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_PRODUCTION_KEY
AI_GEMINI_API_KEY=AIzaSy-REPLACE_WITH_GEMINI_PRODUCTION_KEY

# ------------------------------------------------------------------------------
# 9. OMNICHANNEL OUTBOUND INTEGRATIONS (PRD Domain D)
# ------------------------------------------------------------------------------
# Resend Email Dispatch
OUTBOUND_RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY

# Twilio SMS Gateway
OUTBOUND_TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_TWILIO_ACCOUNT_SID
OUTBOUND_TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN

# Meta WhatsApp Cloud API (v21.0)
OUTBOUND_WHATSAPP_ACCESS_TOKEN=EAA_REPLACE_WITH_META_WHATSAPP_ACCESS_TOKEN
