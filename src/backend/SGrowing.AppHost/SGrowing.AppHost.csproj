<Project Sdk="Aspire.AppHost.Sdk/9.1.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);ASPIRE002;NU1503</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="Aspire" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SGrowing.Api\SGrowing.Api.csproj" />
    <ProjectReference Include="..\SGrowing.McpServer\SGrowing.McpServer.csproj" />
    <ProjectReference Include="..\SGrowing.Worker\SGrowing.Worker.csproj" />
  </ItemGroup>

  <Target Name="_IsProjectRestoreSupported" Returns="@(_ValidProjectsForRestore)">
    <ItemGroup>
      <_ValidProjectsForRestore Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
  </Target>

</Project>
