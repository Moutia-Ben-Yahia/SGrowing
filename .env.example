# ==============================================================================
# SGrowing AI-Native Growth OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure your hosting provider / secrets manager)
# For local development with Docker Compose or Aspire AppHost.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & INFRASTRUCTURE
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_USER=sgrowing
POSTGRES_PASSWORD=sgrowing_secure_password_2026
POSTGRES_DB=sgrowing
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sgrowing;Username=sgrowing;Password=sgrowing_secure_password_2026
ConnectionStrings__Redis=localhost:6379,abortConnect=false

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY (PRD Section 4.2)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret key
Jwt__Key=super_secret_sgrowing_jwt_key_at_least_32_chars_2026!
Jwt__Issuer=https://api.sgrowing.io
Jwt__Audience=SGrowing.Clients
Jwt__TokenLifetimeMinutes=60
Jwt__RefreshTokenLifetimeDays=7

# ------------------------------------------------------------------------------
# 3. AI GATEWAY & MULTI-MODEL FALLBACK CHAIN (PRD Domain J)
# ------------------------------------------------------------------------------
# Priority 0: OpenAI (Primary)
AI__OpenAI__ApiKey=sk-proj-YOUR_OPENAI_API_KEY
AI__OpenAI__Model=gpt-4o
AI__OpenAI__BaseUrl=https://api.openai.com/v1

# Priority 1: Anthropic (Fallback 1)
AI__Anthropic__ApiKey=sk-ant-api03-YOUR_ANTHROPIC_KEY
AI__Anthropic__Model=claude-3-5-sonnet
AI__Anthropic__BaseUrl=https://api.anthropic.com/v1

# Priority 2: Local LLM (Fallback 2 - Ollama / vLLM / Local AI)
AI__Ollama__BaseUrl=http://localhost:11434
AI__Local__Model=llama-3.3-70b

# Priority 3: Google Gemini (Fallback 3)
AI__Gemini__ApiKey=AIzaSy-YOUR_GOOGLE_GEMINI_KEY
AI__Gemini__Model=gemini-2.5-flash
AI__Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 4. OUTBOUND & OMNICHANNEL DISPATCHERS (PRD Domain D)
# ------------------------------------------------------------------------------
# Email Dispatch (Resend API or standard SMTP)
Outbound__Email__ResendApiKey=re_YOUR_RESEND_API_KEY
Outbound__Email__SmtpHost=smtp.resend.com
Outbound__Email__SmtpPort=587
Outbound__Email__SmtpUsername=resend
Outbound__Email__SmtpPassword=re_YOUR_RESEND_API_KEY
Outbound__Email__SenderAddress=growth@yourdomain.com

# Twilio SMS
Outbound__Twilio__AccountSid=AC_YOUR_TWILIO_ACCOUNT_SID
Outbound__Twilio__AuthToken=YOUR_TWILIO_AUTH_TOKEN
Outbound__Twilio__FromNumber=+15551234567

# Meta WhatsApp Cloud API (v21.0)
Outbound__WhatsApp__AccessToken=EAA_YOUR_META_WHATSAPP_TOKEN
Outbound__WhatsApp__PhoneNumberId=109283746592837
Outbound__WhatsApp__BusinessAccountId=918273645102938

# ------------------------------------------------------------------------------
# 5. ADVERTISING CONVERSIONS API (CAPI) (PRD Domain C6)
# ------------------------------------------------------------------------------
# Meta CAPI
Advertising__Meta__PixelId=123456789012345
Advertising__Meta__AccessToken=EAA_YOUR_META_GRAPH_ACCESS_TOKEN
Advertising__Meta__TestEventCode=TEST12345

# Google Ads Conversion API
Advertising__Google__CustomerId=123-456-7890
Advertising__Google__DeveloperToken=YOUR_GOOGLE_ADS_DEV_TOKEN
Advertising__Google__ClientId=YOUR_GOOGLE_CLIENT_ID
Advertising__Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET
Advertising__Google__RefreshToken=YOUR_GOOGLE_REFRESH_TOKEN

# ------------------------------------------------------------------------------
# 6. COMMERCE & PAYMENTS (PRD Domain G)
# ------------------------------------------------------------------------------
Commerce__Stripe__SecretKey=sk_test_YOUR_STRIPE_SECRET_KEY
Commerce__Stripe__PublishableKey=pk_test_YOUR_STRIPE_PUB_KEY
Commerce__Stripe__WebhookSecret=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:5000
